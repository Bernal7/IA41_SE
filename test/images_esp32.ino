// --- FIN DE TU CÓDIGO GENERADO ---

void setup() {
  Serial.begin(115200);
  Wire.begin(); 

  if(!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) { 
    Serial.println(F("Error: Pantalla SSD1306 no encontrada"));
    while(true);
  }

  display.clearDisplay();

  // Dibuja tu mapa de bits
  // Parámetros: (pos_x, pos_y, nombre_del_array, ancho_imagen, alto_imagen, color)
  // Ajusta 'pos_x' y 'pos_y' para mover tu imagen
  // Asegúrate de que 'ancho_imagen' y 'alto_imagen' coincidan con el tamaño REAL de tu imagen
  display.drawBitmap(
    (SCREEN_WIDTH - ANCHO_TU_IMAGEN) / 2, // Centrar horizontalmente
    (SCREEN_HEIGHT - ALTO_TU_IMAGEN) / 2, // Centrar verticalmente
    mikussss,               // Tu array de imagen
    ANCHO_TU_IMAGEN,                     // Ancho de tu imagen (ej. 32)
    ALTO_TU_IMAGEN,                      // Alto de tu imagen (ej. 32)
    SSD1306_WHITE);                      // Color (blanco)

  display.display(); 
}

